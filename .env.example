# Copy to .env. Spring reads this as a properties file: do not quote values.
# local/dev/prod use PostgreSQL. Automated tests use a separate database.
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public web fallback base used for location share links.
PLACE_SHARE_BASE_URL=

# Used by the local/dev profiles and compose.yaml.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boongboongus
DB_USERNAME=boongboongus
DB_PASSWORD=replace-with-local-db-password

# Kakao Map Local and Kakao Mobility Directions. Set server-side only.
KAKAO_LOCAL_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=

# Kakao Login REST API key and comma-separated registered callback URLs.
KAKAO_LOGIN_REST_API_KEY=
KAKAO_LOGIN_REDIRECT_URIS=

# Kakao token exchange and Base64-encoded random JWT key (at least 32 bytes).
KAKAO_LOGIN_CLIENT_SECRET=
AUTH_TOKEN_KEY=


# DJ recommendation
GROQ_API_KEY=
GROQ_DJ_MODEL=openai/gpt-oss-20b
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI radio
ELEVENLABS_API_KEY=
# Data.go.kr KMA village forecast service key for current home weather.
KMA_SERVICE_KEY=
